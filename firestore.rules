rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function protectedFields() {
      return ['isPremium', 'premiumStartDate', 'premiumEndDate', 'premiumProductId',
        'premiumPurchaseDate', 'premiumRestoredAt', 'isTestPurchase', 'membershipDeletionPending'];
    }
    match /users/{uid} {
      allow read: if owner(uid);
      // Keep initial false compatible with existing registration; it grants nothing.
      allow create: if owner(uid)
        && request.resource.data.get('isPremium', false) == false
        && !request.resource.data.keys().hasAny(['premiumStartDate', 'premiumEndDate',
          'premiumProductId', 'premiumPurchaseDate', 'premiumRestoredAt',
          'isTestPurchase', 'membershipDeletionPending']);
      allow update: if owner(uid)
        && resource.data.get('membershipDeletionPending', false) == false
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedFields());
      // Account deletion is performed by the authenticated deleteAccount function.
      allow delete: if false;
      match /notifications/{id} {
        allow read: if owner(uid);
        allow write: if owner(uid)
          && exists(/databases/$(database)/documents/users/$(uid))
          && get(/databases/$(database)/documents/users/$(uid)).data.get('membershipDeletionPending', false) == false;
      }
      match /private/{document=**} { allow read, write: if false; }
    }
  }
}
